<header class="site-header">
  <nav class="container site-nav" aria-label="Main navigation">
    <a href="/" class="site-logo">Book<span>Shop</span></a>

    <div class="site-nav__links">
      <a href="/">Home</a>
      <a href="/books">Books</a>
      <a href="/books/add-book">Add a book</a>

      <% if (username && username !== "guest") { %>
        <span class="site-nav__user">Hi, <strong><%= username %></strong></span>
        <form action="/logout" method="POST" class="site-nav__form">
          <button type="submit" class="site-nav__button">Log out</button>
        </form>
      <% } else { %>
        <a href="/login" class="site-nav__button">Log in</a>
      <% } %>
    </div>
  </nav>
</header>
