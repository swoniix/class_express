<main class="form-page">
  <section class="form-card">
    <a href="/books" class="page-back-link">← Back to books</a>
    <span class="page-kicker">New book</span>
    <h1>Add a book.</h1>
    <p class="form-card__intro">Fill in the form to add a new book to the catalogue.</p>

    <form method="POST" action="/books/add-book" enctype="multipart/form-data">
      <div class="theme-field">
        <label for="InputTitle">Book title</label>
        <input type="text" name="title" id="InputTitle" placeholder="For example, The Little Prince" required>
      </div>
      <div class="theme-field">
        <label for="InputPrice">Price</label>
        <input type="number" name="price" id="InputPrice" step="0.01" min="0" placeholder="15.00" required>
      </div>
      <div class="theme-field">
        <label for="InputYear">Publication year</label>
        <input type="number" name="year_public" id="InputYear" min="1000" max="2100" placeholder="2026" required>
      </div>
      <div class="theme-field">
        <label for="InputImage">Book cover</label>
        <input type="file" name="image" id="InputImage" accept="image/png, image/jpeg, image/webp">
      </div>
      <label for="InputActive" class="theme-checkbox">
        <input type="checkbox" name="is_active" id="InputActive" value="true" checked>
        The book is available
      </label>
      <button type="submit" class="theme-button theme-button--full">Add book</button>
    </form>
  </section>
</main>
