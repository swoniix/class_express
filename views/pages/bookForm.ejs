<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add book</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 50px 20px;
      font-family: Arial, sans-serif;
      color: #222;
      background-color: #fff;
    }

    main {
      width: 100%;
      max-width: 600px;
      margin: 0 auto;
    }

    h1 {
      margin: 0 0 35px;
      font-size: 36px;
    }

    .form-group {
      margin-bottom: 24px;
    }

    label {
      display: block;
      margin-bottom: 8px;
      font-size: 16px;
      font-weight: 600;
    }

    input[type="text"],
    input[type="number"],
    input[type="file"] {
      width: 100%;
      padding: 12px;
      font-size: 16px;
      background-color: #fff;
      border: 1px solid #aaa;
      border-radius: 5px;
      outline: none;
    }

    input[type="text"]:focus,
    input[type="number"]:focus,
    input[type="file"]:focus {
      border-color: #222;
    }

    input[type="file"] {
      padding: 8px;
    }

    .checkbox-label {
      display: flex;
      align-items: center;
      gap: 10px;
      cursor: pointer;
    }

    input[type="checkbox"] {
      width: 18px;
      height: 18px;
      cursor: pointer;
    }

    button {
      padding: 12px 28px;
      color: #fff;
      background-color: #222;
      border: 1px solid #222;
      border-radius: 5px;
      font-size: 16px;
      cursor: pointer;
    }

    button:hover {
      color: #222;
      background-color: #fff;
    }
  </style>
</head>

<body>

  <main>
    <h1>Add your book</h1>

    <form method="POST" action="#" enctype="multipart/form-data">

      <div class="form-group">
        <label for="InputTitle">Title:</label>
        <input type="text" name="title" id="InputTitle" required>
      </div>

      <div class="form-group">
        <label for="InputPrice">Price:</label>
        <input type="number" name="price" id="InputPrice" step="0.01" min="0" required>
      </div>

      <div class="form-group">
        <label for="InputYear">Publication year:</label>
        <input type="number" name="year_public" id="InputYear" min="1000" max="2100" required>
      </div>

      <div class="form-group">
        <label for="InputImage">Image:</label>
        <input type="file" name="image" id="InputImage" accept="image/png, image/jpeg, image/webp">
      </div>

      <div class="form-group">
        <label for="InputActive" class="checkbox-label">
          <input type="checkbox" name="is_active" id="InputActive" value="true" checked>
          Is Active?
        </label>
      </div>

      <button type="submit">Add book</button>

    </form>
  </main>

</body>

</html>