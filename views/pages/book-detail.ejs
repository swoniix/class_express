<main class="container py-5">
  <a href="/books" class="btn btn-outline-secondary mb-4">← Все книги</a>
  <% if (book) { %>
    <div class="row g-4 align-items-start">
      <div class="col-md-4">
        <img src="/image/<%= book.image %>" alt="<%= book.title %>"
             class="img-fluid rounded shadow-sm" style="max-height: 480px;">
      </div>
      <div class="col-md-8">
        <p class="text-muted">Книга № <%= book.id %></p>
        <h1><%= book.title %></h1>
        <p class="fs-3 fw-bold mt-3"><%= book.price %> $</p>
        <p><%= book.is_active ? "В наличии" : "Нет в наличии" %></p>
      </div>
    </div>
  <% } else { %>
    <h1><%= title %></h1>
    <p><%= message %></p>
  <% } %>
</main>
