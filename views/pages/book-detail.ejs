<main class="detail-page container">
  <a href="/books" class="page-back-link">← All books</a>
  <% if (book) { %>
    <div class="detail-card">
      <div class="detail-card__cover">
        <% if (book.image) { %>
          <img
            src="<%= book.image.startsWith('/') ? `/image${book.image}` : `/image/${book.image}` %>"
            alt="<%= book.title %>"
            class="detail-card__image"
          >
        <% } else { %>
          <div class="detail-card__placeholder">No cover</div>
        <% } %>
      </div>
      <div class="detail-card__content">
        <p class="detail-card__label">Book #<%= book.id %></p>
        <h1><%= book.title %></h1>
        <p class="detail-card__price">$<%= book.price %></p>
        <p class="detail-card__status <%= book.is_active ? 'is-available' : '' %>">
          <%= book.is_active ? "Available now" : "Not available" %>
        </p>
        <a href="/books" class="theme-button">Continue shopping</a>
      </div>
    </div>
  <% } else { %>
    <h1><%= title %></h1>
    <p><%= message %></p>
  <% } %>
</main>
