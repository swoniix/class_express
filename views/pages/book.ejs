<main class="catalogue-page">
  <section class="page-hero">
    <div class="container page-hero__inner">
      <div>
        <span class="page-kicker">Our collection</span>
        <h1>Choose your next book.</h1>
        <p>Look through the catalogue and find a story for your free time.</p>
      </div>
      <a href="/books/add-book" class="theme-button">+ Add a book</a>
    </div>
  </section>

  <section class="container catalogue-section">
    <% if (books.length === 0) { %>
      <div class="empty-state">
        <h2>No books yet</h2>
        <p>Add the first book to the catalogue.</p>
      </div>
    <% } %>

    <div class="books-grid">
      <% books.forEach(book => { %>
        <article class="book-card">
          <a href="/books/<%= book.id %>" class="book-card__image">
            <% if (book.image) { %>
              <img
                src="<%= book.image.startsWith('/') ? `/image${book.image}` : `/image/${book.image}` %>"
                alt="<%= book.title %>"
              >
            <% } else { %>
              <div class="book-card__image-placeholder">No cover</div>
            <% } %>
            <span class="book-card__badge"><%= book.is_active ? "Available" : "Not available" %></span>
          </a>

          <div class="book-card__content">
            <p class="book-card__label">Book #<%= book.id %></p>
            <h2 class="book-card__title"><%= book.title %></h2>
            <span class="book-card__price">$<%= book.price %></span>

            <div class="book-card__actions">
              <a href="/books/<%= book.id %>" class="book-card__button">Details</a>
              <button
                type="button"
                class="book-card__button book-card__button--soft"
                data-edit-book
                data-id="<%= book.id %>"
                data-title="<%= book.title %>"
                data-price="<%= book.price %>"
                data-active="<%= book.is_active %>"
              >Edit</button>
              <form
                action="/books/delete/<%= book.id %>"
                method="post"
                class="book-card__delete-form"
                onsubmit="return confirm('Do you want to delete this book?')"
              >
                <button type="submit" class="book-card__button book-card__button--text">Delete</button>
              </form>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  </section>
</main>

<div class="edit-modal" id="editModal" aria-hidden="true">
  <div class="edit-modal__content" role="dialog" aria-modal="true" aria-labelledby="editModalTitle">
    <div class="edit-modal__header">
      <div>
        <span class="page-kicker">Update the details</span>
        <h2 id="editModalTitle">Edit book</h2>
      </div>
      <button type="button" class="edit-modal__close" data-close-modal aria-label="Close">&times;</button>
    </div>

    <form id="editBookForm" method="post" enctype="multipart/form-data">
      <div class="theme-field">
        <label for="editTitle">Title</label>
        <input type="text" name="title" id="editTitle" required>
      </div>
      <div class="theme-field">
        <label for="editPrice">Price</label>
        <input type="number" name="price" id="editPrice" step="0.01" min="0" required>
      </div>
      <div class="theme-field">
        <label for="editImage">New cover</label>
        <input type="file" name="image" id="editImage" accept="image/png, image/jpeg, image/webp">
        <small>Leave this field empty to keep the old cover.</small>
      </div>
      <label for="editActive" class="theme-checkbox">
        <input type="checkbox" name="is_active" id="editActive" value="true">
        The book is available
      </label>
      <button type="submit" class="theme-button theme-button--full">Save changes</button>
    </form>
  </div>
</div>

<script>
  const editModal = document.querySelector("#editModal");
  const editBookForm = document.querySelector("#editBookForm");
  const editTitle = document.querySelector("#editTitle");
  const editPrice = document.querySelector("#editPrice");
  const editActive = document.querySelector("#editActive");
  const editImage = document.querySelector("#editImage");

  const closeEditModal = () => {
    editModal.classList.remove("edit-modal_open");
    editModal.setAttribute("aria-hidden", "true");
    editImage.value = "";
  };

  document.querySelectorAll("[data-edit-book]").forEach((button) => {
    button.addEventListener("click", () => {
      editBookForm.action = `/books/edit/${button.dataset.id}`;
      editTitle.value = button.dataset.title;
      editPrice.value = button.dataset.price;
      editActive.checked = button.dataset.active === "true";
      editModal.classList.add("edit-modal_open");
      editModal.setAttribute("aria-hidden", "false");
      editTitle.focus();
    });
  });

  document.querySelector("[data-close-modal]").addEventListener("click", closeEditModal);
  editModal.addEventListener("click", (event) => {
    if (event.target === editModal) closeEditModal();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeEditModal();
  });
</script>
